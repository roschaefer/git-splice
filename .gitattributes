# scrut/ is a splice of our scrut fork, for development only: keep it and its
# Cargo.lock out of the release tarballs, which CI makes with git archive.
/scrut/ export-ignore
/nix/scrut.Cargo.lock export-ignore

# Keep scrut's Rust out of GitHub's language statistics: it isn't
# git-splice's code.
/scrut/** linguist-vendored

# Keep the tests out of them too: most of the shell is the bats suite, which
# would make a Rust tool look like a shell one to someone choosing it.
/test/** linguist-documentation
