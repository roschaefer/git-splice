#!/usr/bin/env bash
# check-drawing: checks a draw.io drawing of commit graphs against the
# repositories it shows. See README.md next to this file for the drawing
# vocabulary and its limits. Runs as a command, or sourced for
# check_drawing.

# The checker is the Rust tool next to this script: `just build` puts it in
# target/debug. Absolute, since callers change folders between sourcing this
# and calling check_drawing.
CHECK_DRAWING_TOOL="${CHECK_DRAWING_TOOL:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/target/debug/check-drawing}"

# check_drawing <drawing> [--alias <name>=<term>...] [<label>=<rev>...]
# Prints "ok" and what it checked, or each difference, and fails.
check_drawing() {
  "$CHECK_DRAWING_TOOL" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  check_drawing "$@"
fi
