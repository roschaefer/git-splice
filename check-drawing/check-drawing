#!/usr/bin/env bash
# check-drawing: checks a drawing of commit graphs, plain SVG or draw.io,
# against the repositories it shows. See README.md next to this file for
# the drawing vocabulary and its limits. Runs as a command, or sourced for
# check_drawing.

# svg_cells <drawing.svg>
# The cells of a plain SVG drawing, as check_drawing reads a draw.io
# diagram's, but taken from what the picture shows: a circle with a text
# in it is a commit, a rect with a text a box, or a lane if the text is a
# folder, a line or polyline with an arrowhead an arrow between the shapes
# its ends touch, a line without one a separator. Dashed is a
# stroke-dasharray. The drawing is in a fixed format, the elements and
# attributes below, so nothing outside it can change the picture
# unnoticed. A cell "!" carries an error: what isn't in the format.
svg_cells() {
  local arrow
  arrow="$(xmlstarlet sel -T -N s=http://www.w3.org/2000/svg -t -v 'count(/s:svg/s:defs/s:marker[@id="arrow" and s:*])' "$1" 2>/dev/null)"
  # One line per element outside <defs>: its namespace, its depth, its
  # parent's and its own name, its attributes as name=value joined by
  # \x1e, its content and how many elements it holds.
  xmlstarlet sel -T -t -m '//*[not(ancestor::*[local-name()="defs"])]' \
    -v 'namespace-uri()' -o $'\x1f' -v 'count(ancestor::*)' -o $'\x1f' -v 'name(..)' -o $'\x1f' -v 'name()' -o $'\x1f' \
    -m '@*' -v 'name()' -o '=' -v 'normalize-space(.)' -o $'\x1e' -b -o $'\x1f' \
    -v 'normalize-space(.)' -o $'\x1f' -v 'count(*)' -n "$1" 2>/dev/null |
    awk -F $'\x1f' -v OFS=$'\x1f' -v arrow="$arrow" '
      function err(m) { print "!", "", m }
      function at(x, y) { return sprintf("%g,%g", x, y) }
      function has(list, word) { return index(list, " " word " ") > 0 }
      function listed(list) { list = substr(list, 2, length(list) - 2); gsub(/ /, ", ", list); return list }
      BEGIN {
        # The format: what each element may have.
        attrs["svg"] = " width height viewBox "
        attrs["style"] = " "
        attrs["defs"] = " "
        attrs["circle"] = " cx cy r stroke-dasharray class "
        attrs["rect"] = " x y width height rx stroke-dasharray class "
        attrs["line"] = " x1 y1 x2 y2 stroke-dasharray marker-end class "
        attrs["polyline"] = " points stroke-dasharray marker-end class "
        attrs["text"] = " x y class "
        numeric = " cx cy r x y width height rx x1 y1 x2 y2 "
        number = "^[-+]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][-+]?[0-9]+)?$"
        # The stylesheet styles every shape alike: colors, strokes and fonts.
        css = " fill stroke stroke-width background-color font-family font-size font-weight text-anchor dominant-baseline "
      }
      $1 != "http://www.w3.org/2000/svg" { err("a <" $4 ">: check-drawing reads circles, rects, lines, polylines and texts only"); next }
      $2 > 0 && $4 == "svg" { err("an <svg> is inside the <svg>: put each shape directly into the outer one"); next }
      $2 > 1 { err("a <" $4 "> is inside a <" $3 ">: put each shape directly into the <svg>"); next }
      !($4 in attrs) { err("a <" $4 ">: check-drawing reads circles, rects, lines, polylines and texts only"); next }
      {
        el = $4
        split("", A)
        k = split($5, pairs, "\036")
        ok = 1
        for (j = 1; j <= k; j++) {
          if ((e = index(pairs[j], "=")) == 0) continue
          p = substr(pairs[j], 1, e - 1); v = substr(pairs[j], e + 1); A[p] = v
          if (!has(attrs[el], p)) {
            err("a <" el "> has " p ": check-drawing reads " (attrs[el] == " " ? "none" : "only " listed(attrs[el])) " on a <" el ">, so remove it")
            ok = 0
          } else if (has(numeric, p) && v !~ number) {
            err("a <" el "> has " p "=\"" v "\", which isn\047t a plain number")
            ok = 0
          }
        }
        if (el == "style") {
          stylesheet($6)
          next
        }
        if (el == "text" && $7 > 0) { err("the text " $6 " holds other elements, e.g. a <tspan>: write the label as plain text"); next }
        if ("marker-end" in A && A["marker-end"] != "url(#arrow)") { err("a <" el "> has marker-end=\"" A["marker-end"] "\": an arrowhead is url(#arrow)"); ok = 0 }
        if ("marker-end" in A && !arrow) { err("the arrowhead url(#arrow) is drawn by no <marker id=\"arrow\"> in <defs>: add one"); ok = 0 }
        if (!ok || el == "svg" || el == "defs") next
        dashed = 0
        if ("stroke-dasharray" in A) {
          k = split(A["stroke-dasharray"], lengths, /[ ,]+/)
          for (j = 1; j <= k; j++) {
            if (lengths[j] !~ number || lengths[j] < 0) { dashed = -1; break }
            if (lengths[j] > 0) dashed = 1
          }
          if (dashed < 1) { err("a <" el "> has stroke-dasharray=\"" A["stroke-dasharray"] "\": give it dash lengths, like \"6 4\""); next }
        }
        if (el == "circle") {
          n++; kind[n] = "circle"; cx[n] = A["cx"] + 0; cy[n] = A["cy"] + 0; rr[n] = A["r"] + 0; dash[n] = dashed
        } else if (el == "rect") {
          n++; kind[n] = "rect"; x[n] = A["x"] + 0; y[n] = A["y"] + 0; w[n] = A["width"] + 0; h[n] = A["height"] + 0; dash[n] = dashed
        } else if (el == "text") {
          if ($6 != "") { nt++; tx[nt] = A["x"] + 0; ty[nt] = A["y"] + 0; tl[nt] = $6 }
        } else {
          na++; adash[na] = dashed; arrow_[na] = "marker-end" in A
          if (el == "line") {
            px[na, 1] = A["x1"] + 0; py[na, 1] = A["y1"] + 0; px[na, 2] = A["x2"] + 0; py[na, 2] = A["y2"] + 0; np[na] = 2
          } else {
            k = split(A["points"], coords, /[ ,]+/)
            if (k < 4 || k % 2) { err("the polyline " A["points"] " isn\047t two or more points"); na--; next }
            for (j = 1; j <= k; j++) {
              if (coords[j] !~ number) { err("the polyline " A["points"] " has " coords[j] ", which isn\047t a plain number"); na--; next }
            }
            np[na] = k / 2
            for (j = 1; j <= np[na]; j++) { px[na, j] = coords[2 * j - 1] + 0; py[na, j] = coords[2 * j] + 0 }
            if (!arrow_[na]) { err("the polyline from " at(px[na, 1], py[na, 1]) " has no arrowhead: give it marker-end, or draw a separator as a line"); na--; next }
          }
        }
      }
      function stylesheet(sheet,   p, seen) {
        gsub(/\([^)]*\)/, "", sheet)
        while (match(sheet, /[{;][ ]*[-a-zA-Z]+[ ]*:/)) {
          p = substr(sheet, RSTART + 1, RLENGTH - 2)
          sheet = substr(sheet, RSTART + RLENGTH)
          gsub(/ /, "", p)
          if (has(css, p) || has(seen, p)) continue
          seen = seen " " p " "
          err("the <style> sets " p ": it may set only " listed(css))
        }
      }
      function area(i) { return kind[i] == "circle" ? 3.15 * rr[i] * rr[i] : w[i] * h[i] }
      function holds(i, a, b) {
        if (kind[i] == "circle") return (a - cx[i]) ^ 2 + (b - cy[i]) ^ 2 <= rr[i] ^ 2
        return a >= x[i] && a <= x[i] + w[i] && b >= y[i] && b <= y[i] + h[i]
      }
      function abs(v) { return v < 0 ? -v : v }
      function min(a, b) { return a < b ? a : b }
      # Whether point a,b lies on the outline of shape i, within 3 units.
      function touches(i, a, b,   d) {
        if (kind[i] == "circle") return abs(sqrt((a - cx[i]) ^ 2 + (b - cy[i]) ^ 2) - rr[i]) <= 3
        if (a < x[i] - 3 || a > x[i] + w[i] + 3 || b < y[i] - 3 || b > y[i] + h[i] + 3) return 0
        d = min(min(abs(a - x[i]), abs(a - x[i] - w[i])), min(abs(b - y[i]), abs(b - y[i] - h[i])))
        return d <= 3
      }
      # The commit or box whose outline point a,b touches: the smallest.
      function attached(a, b,   i, best) {
        best = 0
        for (i = 1; i <= n; i++)
          if ((kind[i] == "circle" || !lane[i]) && touches(i, a, b) && (!best || area(i) < area(best))) best = i
        return best
      }
      END {
        # Each text belongs to the smallest shape around it.
        for (t = 1; t <= nt; t++) {
          best = 0
          for (i = 1; i <= n; i++)
            if (holds(i, tx[t], ty[t]) && (!best || area(i) < area(best))) best = i
          owner[t] = best
          if (best && tl[t] ~ /^[^ ]+\/$/ && kind[best] == "rect" && !lane[best]) { lane[best] = 1; label[best] = tl[t]; used[t] = 1 }
        }
        for (t = 1; t <= nt; t++) {
          i = owner[t]
          if (!i || used[t] || lane[i]) continue
          texts[i]++
          label[i] = texts[i] == 1 ? tl[t] : label[i] ", " tl[t]
          used[t] = 1
        }
        for (i = 1; i <= n; i++) {
          what = kind[i] == "circle" ? "circle" : "rect"
          where = kind[i] == "circle" ? at(cx[i], cy[i]) : at(x[i], y[i])
          if (!lane[i] && texts[i] != 1) {
            err("the " what " at " where (texts[i] ? " has " texts[i] " labels, " label[i] ": give it one" : " has no label: write one into it"))
            bad[i] = 1
            continue
          }
          if (kind[i] == "circle")
            print "s" i, "v1e", label[i], "ellipse;" (dash[i] ? "dashed=1;" : ""), "", "", "1", cx[i] - rr[i], cy[i] - rr[i], 2 * rr[i], 2 * rr[i]
          else
            print "s" i, "v1e", label[i], "rounded=1;" (dash[i] ? "dashed=1;" : ""), "", "", "1", x[i], y[i], w[i], h[i]
        }
        # Texts in no shape, or in a lane: an upstream name or a box by its label.
        for (t = 1; t <= nt; t++)
          if (!used[t]) print "t" t, "v1e", tl[t], "text;", "", "", "1", tx[t], ty[t], 0, 0
        for (a = 1; a <= na; a++) {
          if (!arrow_[a]) {
            x1 = px[a, 1]; y1 = py[a, 1]; x2 = px[a, 2]; y2 = py[a, 2]
            print "l" a, "v1e", "", "line;" (adash[a] ? "dashed=1;" : "") (x1 == x2 ? "direction=south;" : ""), "", "", "1", \
              min(x1, x2), min(y1, y2), abs(x2 - x1), abs(y2 - y1)
            continue
          }
          s = 1; e = np[a]
          from = attached(px[a, s], py[a, s]); to = attached(px[a, e], py[a, e])
          if (!from || !to) {
            err("the arrow from " at(px[a, s], py[a, s]) " to " at(px[a, e], py[a, e]) " doesn\047t touch a commit or box at its " \
              (!from && !to ? "start or end" : !from ? "start" : "end") ": end it on the outline")
            continue
          }
          if (bad[from] || bad[to]) continue
          print "e" a, "v0e1", "", "endArrow=block;" (adash[a] ? "dashed=1;" : ""), "s" from, "s" to, "1", 0, 0, 0, 0
        }
      }'
}

# check_drawing <drawing> [--alias <name>=<term>...] [<label>=<rev>...]
# Prints "ok" and what it checked, or each difference, and fails.
check_drawing() {
  local drawing="$1" xml default=""
  # git-splice's lib/, unless given: next to the git-splice on PATH, as in
  # a checkout, or in share/git-splice/, as installed.
  local DRAWING_LIB="${GIT_SPLICE_LIB:-}" bin
  if [[ -z "$DRAWING_LIB" ]]; then
    bin="$(dirname "$(readlink -f "$(command -v git-splice)")")"
    DRAWING_LIB="$bin/lib"
    [[ -d "$DRAWING_LIB" ]] || DRAWING_LIB="$bin/../share/git-splice/lib"
  fi
  shift
  local -A rev_of=() commit_of=() label_of=() kind=() value=() style=() source=() target=() parent=()
  local -A gx=() gy=() gw=() gh=() truth=() splice_of=() lane_of=() is_splice=() lane_splice=() lane_label=()
  local -a errors=() commits=() edges=() boxes=() lanes=() splices=() separators=() sides=()
  local -A lane_id=() side_of=() side_key=() region_name=() region_key=() drawn_on_side=()
  local -A id_of_label=() label_count=() alias=()
  local id k cells term shown named sp p
  local name='([HBTR]|U\([^()]+\)|[^ ]+)'
  local box_label="^$name( = $name)*\$"

  while [[ $# -gt 0 ]]; do
    if [[ "$1" == --alias ]]; then
      alias[${2%%=*}]="${2#*=}"
      shift 2
    else
      rev_of[${1%%=*}]="${1#*=}"
      shift
    fi
  done

  # One line per cell, fields separated by \x1f: read collapses repeated
  # tabs, and so would shift the fields after an empty one. A plain SVG's
  # cells come from its shapes; a draw.io drawing's from its diagram, with
  # labels as plain text: no html=1.
  local plain=""
  if [[ "$drawing" == *.svg && "$drawing" != *.drawio.svg ]]; then
    plain=1
    cells="$(svg_cells "$drawing")"
  else
    if [[ "$drawing" == *.svg ]]; then
      xml="$(xmlstarlet sel -T -N s=http://www.w3.org/2000/svg -t -v '/s:svg/@content' "$drawing" 2>/dev/null)"
    else
      xml="$(cat "$drawing")"
    fi
    if [[ "$(xmlstarlet sel -T -t -v 'count(//mxGraphModel)' <<<"$xml" 2>/dev/null)" != 1 ]]; then
      printf '!!   %s: no diagram inside, or a compressed one: save it with File > Properties > Compressed off\n' "${drawing##*/}"
      return 1
    fi
    cells="$(xmlstarlet sel -T -t -m '//mxCell[@id!="0" and @id!="1"]' \
      -v '@id' -o $'\x1f' -v 'concat("v",@vertex,"e",@edge)' -o $'\x1f' -v '@value' -o $'\x1f' -v '@style' -o $'\x1f' \
      -v '@source' -o $'\x1f' -v '@target' -o $'\x1f' -v '@parent' -o $'\x1f' \
      -v 'mxGeometry/@x' -o $'\x1f' -v 'mxGeometry/@y' -o $'\x1f' -v 'mxGeometry/@width' -o $'\x1f' -v 'mxGeometry/@height' -n <<<"$xml")"
  fi
  local c_id c_kind c_value c_style c_source c_target c_parent c_x c_y c_w c_h
  while IFS=$'\x1f' read -r c_id c_kind c_value c_style c_source c_target c_parent c_x c_y c_w c_h; do
    [[ -n "$c_id" ]] || continue
    if [[ "$c_id" == "!" ]]; then
      errors+=("$c_value")
      continue
    fi
    value[$c_id]="$c_value" style[$c_id]="$c_style" source[$c_id]="$c_source" target[$c_id]="$c_target"
    parent[$c_id]="$c_parent" gx[$c_id]="${c_x:-0}" gy[$c_id]="${c_y:-0}" gw[$c_id]="${c_w:-0}" gh[$c_id]="${c_h:-0}"
    if [[ "$c_kind" == *e1 ]]; then
      kind[$c_id]=edge
      edges+=("$c_id")
    elif [[ "$c_style" == ellipse* || "$c_style" == *";ellipse"* ]]; then
      kind[$c_id]=commit
      commits+=("$c_id")
    elif [[ "$c_style" == line* || "$c_style" == *";line;"* ]]; then
      kind[$c_id]=separator
      separators+=("$c_id")
    elif [[ "$c_value" =~ ^[^\ ]+/$ ]]; then
      kind[$c_id]=lane
      lanes+=("$c_id")
    elif [[ "$c_style" == text* || "$c_style" == *";text;"* ]]; then
      # An upstream's name, if it's in a split lane; a box by its label
      # otherwise.
      kind[$c_id]=side
      sides+=("$c_id")
    elif [[ "$c_value" =~ $box_label ]]; then
      kind[$c_id]=box
      boxes+=("$c_id")
    elif [[ -n "$plain" ]]; then
      errors+=("the box $c_value names no commit: label it H, B, T, R, U(x) or a branch, joined by \" = \"")
    fi
  done <<<"$cells"
  if [[ ${#commits[@]} -eq 0 ]]; then
    printf '!!   %s: no commits drawn\n' "${drawing##*/}"
    return 1
  fi

  # Where a shape is: its absolute position, and whether its center is
  # inside another shape.
  absolute() {
    local cell="$1" x=0 y=0
    while [[ -n "$cell" && "$cell" != 1 && -n "${gx[$cell]+set}" ]]; do
      x=$(awk -v a="$x" -v b="${gx[$cell]}" 'BEGIN { print a + b }')
      y=$(awk -v a="$y" -v b="${gy[$cell]}" 'BEGIN { print a + b }')
      cell="${parent[$cell]}"
    done
    printf '%s %s\n' "$x" "$y"
  }
  inside() {
    local cx cy ox oy
    read -r cx cy < <(absolute "$1")
    read -r ox oy < <(absolute "$2")
    awk -v cx="$cx" -v cy="$cy" -v w="${gw[$1]}" -v h="${gh[$1]}" -v fx="$ox" -v fy="$oy" -v fw="${gw[$2]}" -v fh="${gh[$2]}" \
      'BEGIN { x = cx + w / 2; y = cy + h / 2; exit !(x >= fx && x <= fx + fw && y >= fy && y <= fy + fh) }'
  }
  # Whether a shape lies wholly inside another.
  contains() {
    local cx cy ox oy
    read -r cx cy < <(absolute "$1")
    read -r ox oy < <(absolute "$2")
    awk -v cx="$cx" -v cy="$cy" -v w="${gw[$1]}" -v h="${gh[$1]}" -v fx="$ox" -v fy="$oy" -v fw="${gw[$2]}" -v fh="${gh[$2]}" \
      'BEGIN { exit !(cx >= fx && cx + w <= fx + fw && cy >= fy && cy + h <= fy + fh) }'
  }

  # The splices, and the lanes that name them.
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    splices+=("$p")
    is_splice[$p]=1
  done < <(
    # shellcheck source=/dev/null # git-splice's, linted there
    source "$DRAWING_LIB/common.sh"
    state_files HEAD | tr '\0' '\n' | sed -n 's#/\.splice$##p'
  )
  local l
  for l in "${lanes[@]}"; do
    if [[ -n "${is_splice[${value[$l]%/}]:-}" ]]; then
      lane_splice[$l]="${value[$l]%/}"
    else
      errors+=("the lane ${value[$l]} isn't a splice of the monorepo")
    fi
  done
  if [[ ${#splices[@]} -eq 1 ]]; then
    default="${splices[0]}"
  elif [[ ${#splices[@]} -gt 1 && ${#lanes[@]} -eq 0 ]]; then
    printf '!!   the monorepo has %d splices: draw a lane for each one the drawing shows, labelled with its folder, e.g. %s/\n' \
      "${#splices[@]}" "${splices[0]:-vendor/a}"
    return 1
  fi
  # A shape is in the innermost lane around it. Lanes nest as their
  # folders do.
  local o area smallest
  for l in "${lanes[@]}"; do
    for o in "${lanes[@]}"; do
      [[ "$o" != "$l" ]] && inside "$l" "$o" && [[ "${value[$l]}" != "${value[$o]}"?* ]] &&
        errors+=("the lane ${value[$l]} is drawn inside ${value[$o]}, but its folder isn't inside that one")
      [[ "$o" != "$l" && "${value[$l]}" == "${value[$o]}"?* ]] && ! contains "$l" "$o" &&
        errors+=("the lane ${value[$l]} is a folder inside ${value[$o]}: draw it inside that lane")
    done
  done
  for id in "${commits[@]}" "${boxes[@]}" "${separators[@]}" "${sides[@]}"; do
    lane_of[$id]="" lane_label[$id]="" lane_id[$id]="" smallest=""
    for l in "${lanes[@]}"; do
      if [[ -z "${lane_splice[$l]:-}" ]] || ! contains "$id" "$l"; then
        continue
      fi
      area=$(awk -v w="${gw[$l]}" -v h="${gh[$l]}" 'BEGIN { print w * h }')
      if [[ -z "$smallest" ]] || awk -v a="$area" -v b="$smallest" 'BEGIN { exit !(a < b) }'; then
        lane_of[$id]="${lane_splice[$l]}" lane_label[$id]="${value[$l]}" lane_id[$id]="$l" smallest="$area"
      fi
    done
  done

  # Upstreams side by side: a dashed line, a separator, splits a lane, and
  # a text on each side names the upstream whose commits that side holds.
  # A shape's side is the number of the lane's separators left of its
  # center.
  center_x() {
    local x y
    read -r x y < <(absolute "$1")
    awk -v x="$x" -v w="${gw[$1]}" 'BEGIN { print x + w / 2 }'
  }
  region() {
    local sep n=0 x
    x="$(center_x "$1")"
    for sep in "${separators[@]}"; do
      [[ "${lane_id[$sep]}" == "${lane_id[$1]}" ]] || continue
      awk -v a="$(center_x "$sep")" -v b="$x" 'BEGIN { exit !(a < b) }' && n=$((n + 1))
    done
    printf '%s|%s\n' "${lane_id[$1]}" "$n"
  }
  # The names of the upstreams splice $1's .splice names.
  upstream_names() {
    git config --blob "HEAD:$1/.splice" --name-only --get-regexp '^upstream\..*\.url$' 2>/dev/null |
      sed 's/^upstream\.//; s/\.url$//' || true
  }
  local -A split_lane=() region_named=() lane_upstream=()
  local r n names
  for id in "${separators[@]}"; do
    if [[ -z "${lane_id[$id]}" ]]; then
      errors+=("a separator is in no lane: draw it inside the lane of the splice whose upstreams it separates")
      continue
    fi
    if [[ ";${style[$id]};" != *";dashed=1;"* ]]; then
      errors+=("a line in ${lane_label[$id]} is solid: dash it, a separator is dashed")
      continue
    fi
    if [[ ";${style[$id]};" != *";direction=south;"* && ";${style[$id]};" != *";direction=north;"* ]]; then
      errors+=("a line in ${lane_label[$id]} isn't vertical: a separator runs from top to bottom, direction=south")
      continue
    fi
    split_lane[${lane_id[$id]}]=$((${split_lane[${lane_id[$id]}]:-0} + 1))
  done
  for id in "${sides[@]}"; do
    if [[ -z "${lane_id[$id]}" || -z "${split_lane[${lane_id[$id]}]:-}" ]]; then
      if [[ "${value[$id]}" =~ $box_label ]]; then
        kind[$id]=box
        boxes+=("$id")
      elif [[ -n "$plain" ]]; then
        errors+=("the text ${value[$id]} is neither a label nor an upstream's name: put it in a circle or box, or leave it out")
      fi
      continue
    fi
    r="$(region "$id")"
    region_named[$r]=1
    if [[ -n "${region_name[$r]:-}" ]]; then
      errors+=("${region_name[$r]} and ${value[$id]} name one side of ${lane_label[$id]}: name each side once")
      continue
    fi
    if [[ -n "${lane_upstream["${lane_id[$id]}|${value[$id]}"]:-}" ]]; then
      errors+=("${value[$id]} names two sides of ${lane_label[$id]}: name each side after another upstream")
      continue
    fi
    lane_upstream["${lane_id[$id]}|${value[$id]}"]=1
    names=" $(upstream_names "${lane_of[$id]}" | tr '\n' ' ')"
    if [[ "$names" != *" ${value[$id]} "* ]]; then
      errors+=("${lane_label[$id]} has no upstream named ${value[$id]}: name a side after one of its upstreams,${names% }")
      continue
    fi
    region_key[$r]="$(git splice key --upstream "${value[$id]}" "${lane_of[$id]}" 2>/dev/null)" || region_key[$r]=""
    if [[ -z "${region_key[$r]}" ]]; then
      errors+=("${value[$id]} of ${lane_label[$id]} was never fetched: fetch it before drawing its side")
      continue
    fi
    region_name[$r]="${value[$id]}"
  done
  # Every side is named, even one with nothing on it.
  for l in "${!split_lane[@]}"; do
    for ((n = 0; n <= split_lane[$l]; n++)); do
      [[ -n "${region_named["$l|$n"]:-}" ]] ||
        errors+=("side $((n + 1)) of ${value[$l]}, from the left, names no upstream: label each side with its upstream's name")
    done
  done
  for id in "${commits[@]}" "${boxes[@]}"; do
    [[ -n "${lane_id[$id]}" && -n "${split_lane[${lane_id[$id]}]:-}" ]] || continue
    r="$(region "$id")"
    [[ -n "${region_name[$r]:-}" ]] || continue
    side_of[$id]="${region_name[$r]}" side_key[$id]="${region_key[$r]}"
  done

  # What H names, and B, T, R, U(H) and U(B) of each splice the drawing
  # uses; T through the upstream branch the monorepo's branch maps to.
  truth[H]="$(git rev-parse HEAD)"
  load_truth() {
    local p="$1" c
    [[ -z "${truth["$p|loaded"]:-}" ]] || return 0
    truth["$p|loaded"]=1
    truth["$p|B"]="$(git splice boundary "$p")"
    truth["$p|U"]="$(git config --blob "HEAD:$p/.splice" splice.commit)"
    truth["$p|S"]="$(git config --blob "${truth["$p|B"]}:$p/.splice" splice.commit)"
    truth["$p|T"]="$(git rev-parse --verify --quiet "$(
      # shellcheck source=/dev/null # git-splice's, linted there
      source "$DRAWING_LIB/common.sh"
      require_splice_upstream "$p"
      splice_ref "$p" "$(upstream_branch_for "$p" "$(git branch --show-current)")"
    )")"
    truth["$p|R"]="$(git splice rebuild "$p")"
    truth["$p|base"]=""
    [[ -z "${truth["$p|R"]}" || -z "${truth["$p|T"]}" ]] ||
      truth["$p|base"]="$(git merge-base "${truth["$p|R"]}" "${truth["$p|T"]}")"
    truth["$p|key"]="$(git splice key "$p")"
    truth["$p|synced"]=""
    for c in $(git log --first-parent --format=%H HEAD -- "$p/.splice"); do
      truth["$p|synced"]+=" $(git config --blob "$c:$p/.splice" splice.commit 2>/dev/null)"
    done
  }
  for id in "${commits[@]}" "${boxes[@]}"; do
    sp="${lane_of[$id]:-$default}"
    splice_of[$id]="$sp"
    [[ -z "$sp" ]] || load_truth "$sp"
  done

  # Commits, by label.
  local label base subject hash upstream_tips tip
  for id in "${commits[@]}"; do
    label="${value[$id]}"
    base="${label%\'}"
    sp="${splice_of[$id]}"
    hash=""
    if [[ -n "${rev_of[$label]:-}" ]]; then
      # A copy given in full, e.g. b'=<rev>: several copies of b can look
      # alike, e.g. a pushed one and R's after a 'git rebase'.
      hash="$(git rev-parse --verify --quiet "${rev_of[$label]}^{commit}")"
    elif [[ -n "${rev_of[$base]:-}" ]]; then
      hash="$(git rev-parse --verify --quiet "${rev_of[$base]}^{commit}")"
    else
      # On a side, its upstream's commit first: the monorepo or another
      # upstream may have one with the same subject.
      hash=""
      [[ -z "${side_key[$id]:-}" || "$label" == *\' ]] ||
        hash="$(git log --format='%H%x09%s' --glob="refs/splices/${side_key[$id]}/heads/*" | awk -F'\t' -v s="$base" '$2 == s || index($2, s ": ") == 1 { print $1; exit }')"
      [[ -n "$hash" ]] ||
        hash="$(git log --first-parent --format='%H%x09%s' HEAD | awk -F'\t' -v s="$base" '$2 == s || index($2, s ": ") == 1 { print $1; exit }')"
      upstream_tips=()
      if [[ -n "$sp" ]]; then
        for k in T R U S; do
          [[ -n "${truth["$sp|$k"]}" ]] && upstream_tips+=("${truth["$sp|$k"]}")
        done
      fi
      [[ -z "${side_key[$id]:-}" ]] || upstream_tips+=(--glob="refs/splices/${side_key[$id]}/heads/*")
      [[ -n "$hash" || "$label" == *\' || ${#upstream_tips[@]} -eq 0 ]] ||
        hash="$(git log --format='%H%x09%s' "${upstream_tips[@]}" | awk -F'\t' -v s="$base" '$2 == s || index($2, s ": ") == 1 { print $1; exit }')"
    fi
    if [[ -n "$hash" && "$label" == *\' && -z "${rev_of[$label]:-}" ]]; then
      if [[ -z "$sp" ]]; then
        errors+=("$label is in no lane: draw it in the lane of the splice it's rebuilt for")
        continue
      fi
      subject="$(git log -1 --format='%B%x1f%an%x1f%aD' "$hash")"
      # R's history first: a monorepo commit pushed before a 'git rebase'
      # has an older copy on an upstream branch too.
      upstream_tips=(--glob="refs/splices/${side_key[$id]:-${truth["$sp|key"]}}/heads/*")
      [[ -z "${truth["$sp|R"]}" ]] || upstream_tips=("${truth["$sp|R"]}" "${upstream_tips[@]}")
      hash="$(for tip in "${upstream_tips[@]}"; do
        git log --format='%H' "$tip"
      done | while read -r copy; do
        [[ "$copy" != "$hash" && "$(git log -1 --format='%B%x1f%an%x1f%aD' "$copy")" == "$subject" ]] && {
          echo "$copy"
          break
        }
      done)"
    fi
    if [[ -z "$hash" ]]; then
      errors+=("$label: no such commit")
      continue
    fi
    commit_of[$id]="$hash"
    # A commit on each side of a separator is one commit, drawn once per
    # side.
    if [[ -n "${side_of[$id]:-}" ]]; then
      if [[ -n "${drawn_on_side["$label|${lane_id[$id]}|${side_of[$id]}"]:-}" ]]; then
        errors+=("$label is drawn twice on the ${side_of[$id]} side of ${lane_label[$id]}: draw it once per side")
        continue
      fi
      drawn_on_side["$label|${lane_id[$id]}|${side_of[$id]}"]=1
      if [[ -n "${id_of_label[$label]:-}" && -n "${side_of[${id_of_label[$label]}]:-}" ]]; then
        [[ "${commit_of[${id_of_label[$label]}]:-}" == "$hash" ]] ||
          errors+=("$label names one commit on the ${side_of[${id_of_label[$label]}]} side and another on the ${side_of[$id]} side: label them apart")
        continue
      fi
    fi
    label_of[$hash]="$label"
    id_of_label[$label]="$id"
    label_count[$label]=$((${label_count[$label]:-0} + 1))
  done

  # A commit in a lane is in that splice's upstream history: on R, on a
  # fetched upstream branch, or in a recorded commit's history.
  of_splice() {
    local s
    git merge-base --is-ancestor "$1" "${truth["$2|R"]}" && return 0
    [[ -n "$(git for-each-ref --count=1 --contains "$1" "refs/splices/${truth["$2|key"]}/heads/")" ]] && return 0
    for s in ${truth["$2|synced"]}; do
      git merge-base --is-ancestor "$1" "$s" 2>/dev/null && return 0
    done
    return 1
  }
  # Whether no fetched branch of any upstream splice $2 names has commit $1.
  not_upstream_of() {
    local name key
    while IFS= read -r name; do
      key="$(git splice key --upstream "$name" "$2" 2>/dev/null)" || continue
      [[ -z "$(git for-each-ref --count=1 --contains "$1" "refs/splices/$key/heads/")" ]] || return 1
    done < <(upstream_names "$2")
  }
  # A monorepo commit: on HEAD, or on another branch of the monorepo, like
  # a colleague's work on origin/main.
  in_monorepo() {
    git merge-base --is-ancestor "$1" HEAD 2>/dev/null ||
      [[ -n "$(git for-each-ref --count=1 --contains "$1" refs/heads/ refs/remotes/)" ]]
  }
  for id in "${commits[@]}"; do
    [[ -n "${commit_of[$id]:-}" ]] || continue
    if [[ ${#splices[@]} -eq 0 ]]; then
      in_monorepo "${commit_of[$id]}" ||
        errors+=("${value[$id]} isn't a commit of the monorepo, which has no splices")
      continue
    fi
    if [[ ${#lanes[@]} -gt 0 && -z "${lane_of[$id]}" ]]; then
      in_monorepo "${commit_of[$id]}" ||
        errors+=("${value[$id]} isn't a monorepo commit, but it's outside every lane: draw it in its splice's lane")
      continue
    fi
    [[ -n "${lane_of[$id]}" ]] || continue
    if [[ -n "${side_of[$id]:-}" ]]; then
      [[ -n "$(git for-each-ref --count=1 --contains "${commit_of[$id]}" "refs/splices/${side_key[$id]}/heads/")" ]] && continue
      if ! not_upstream_of "${commit_of[$id]}" "${lane_of[$id]}"; then
        errors+=("${value[$id]} is on the ${side_of[$id]} side, but no fetched branch of ${side_of[$id]} has it: draw it on the side of an upstream that has it")
        continue
      fi
    fi
    of_splice "${commit_of[$id]}" "${lane_of[$id]}" ||
      errors+=("${value[$id]} is in the lane ${lane_of[$id]}/, but isn't in that splice's upstream history or R")
  done

  # A commit of splice $2 is dashed if it isn't in the upstream's history
  # yet: no fetched upstream branch has it. On a side of a separator, the
  # upstream is that side's, key $3.
  not_upstream() {
    [[ -n "$2" ]] || return 1
    ! in_monorepo "$1" || return 1
    [[ -z "$(git for-each-ref --count=1 --contains "$1" "refs/splices/${3:-${truth["$2|key"]}}/heads/")" ]]
  }
  dashed() { [[ ";${style[$1]};" == *";dashed=1;"* ]]; }

  for id in "${commits[@]}"; do
    [[ -n "${commit_of[$id]:-}" ]] || continue
    if not_upstream "${commit_of[$id]}" "${splice_of[$id]}" "${side_key[$id]:-}"; then
      dashed "$id" || errors+=("${value[$id]} is solid, but no upstream branch has it: dash it")
    else
      dashed "$id" && errors+=("${value[$id]} is dashed, but an upstream branch has it: draw it solid")
    fi
  done

  # Succeeds if box term $1 is a branch name, not H, B, T, R, U(x) or
  # merge-base(R,T).
  is_branch_term() {
    [[ "$1" != H && "$1" != [BTR] && "$1" != "merge-base(R,T)" && "$1" != U\(*\) ]]
  }
  # What box term $1 of splice $2 names, or nothing. A branch name in a box
  # pointing at monorepo commit $4 names a monorepo branch, e.g. main or
  # origin/main; otherwise, an upstream branch, as fetched, of the upstream
  # with key $3, if given.
  resolve_term() {
    local term="$1" sp="$2" k c rel
    if is_branch_term "$term" && [[ -n "${4:-}" ]] && in_monorepo "$4"; then
      git rev-parse --verify --quiet "refs/heads/$term^{commit}" ||
        git rev-parse --verify --quiet "refs/remotes/$term^{commit}"
      return 0
    fi
    if [[ "$term" == H ]]; then
      printf '%s\n' "${truth[H]}"
    elif [[ "$term" == [BTR] ]]; then
      printf '%s\n' "${truth["$sp|$term"]}"
    elif [[ "$term" == "merge-base(R,T)" ]]; then
      printf '%s\n' "${truth["$sp|base"]}"
    elif [[ "$term" != U\(*\) ]]; then
      git rev-parse --verify --quiet "refs/splices/${3:-${truth["$sp|key"]}}/heads/$term^{commit}"
    else
      k="${term#U(}" k="${k%)}"
      case "$k" in
        H) printf '%s\n' "${truth["$sp|U"]}" ;;
        B) printf '%s\n' "${truth["$sp|S"]}" ;;
        *)
          c="${id_of_label[$k]}"
          rel="$sp"
          [[ -z "${lane_of[$c]}" ]] || rel="${sp#"${lane_of[$c]}/"}"
          git config --blob "${commit_of[$c]}:$rel/.splice" splice.commit 2>/dev/null
          ;;
      esac
    fi
  }

  # Arrows: between commits, parent to child; from a box, to its commit.
  local s t drawn_edges=" "
  local -A box_arrows=() branch_tips=()
  for id in "${edges[@]}"; do
    s="${source[$id]}" t="${target[$id]}"
    [[ -z "$s" || "${kind[$s]:-}" != box ]] || box_arrows[$s]=$((${box_arrows[$s]:-0} + 1))
    if [[ -z "$s" || -z "$t" ]]; then
      errors+=("an arrow (${id}) isn't attached at both ends: drag its ends onto shapes")
      continue
    fi
    if [[ "${kind[$s]:-}" == box ]]; then
      if [[ "${kind[$t]:-}" != commit ]]; then
        errors+=("${value[$s]} points at something other than a commit")
        continue
      fi
      # A box sits with the commit it points at: in its lane, or outside
      # every lane, like H and B with their monorepo commits.
      if [[ "${lane_of[$s]}" != "${lane_of[$t]}" ]]; then
        if [[ -z "${lane_of[$t]}" ]]; then
          errors+=("${value[$s]} points at ${value[$t]}, which is outside every lane: draw the box outside every lane too")
        else
          errors+=("${value[$s]} points at ${value[$t]}, in the lane ${lane_label[$t]}: draw the box in that lane")
        fi
        continue
      fi
      if [[ "${side_of[$s]:-}" != "${side_of[$t]:-}" ]]; then
        errors+=("${value[$s]} points at ${value[$t]}, on the ${side_of[$t]:-other} side: draw the box on that side")
        continue
      fi
      sp="${splice_of[$s]}"
      while IFS= read -r shown; do
        term="${alias[$shown]:-$shown}"
        if [[ "$term" == U\(*\) ]]; then
          k="${term#U(}" k="${k%)}"
          term="U(${alias[$k]:-$k})"
        fi
        # With several splices, only a lane says whose B is.
        if [[ "$term" == B && -z "$sp" ]]; then
          errors+=("B outside every lane doesn't say which splice's boundary it is: with several splices, leave B out")
          continue
        fi
        if [[ "$term" == U\(*\) ]]; then
          k="${term#U(}" k="${k%)}"
          if [[ "$k" != [HB] && -z "${commit_of[${id_of_label[$k]:-none}]:-}" ]]; then
            errors+=("$shown points at ${value[$t]}, but no commit $k is drawn")
            continue
          fi
          if [[ "$k" != [HB] && "${label_count[$k]:-0}" -gt 1 ]]; then
            errors+=("$shown points at ${value[$t]}, but ${label_count[$k]} commits are labelled $k: label them apart")
            continue
          fi
        fi
        if [[ -n "${rev_of[$shown]:-}" ]]; then
          named="$(git rev-parse --verify --quiet "${rev_of[$shown]}^{commit}")"
        else
          named="$(resolve_term "$term" "$sp" "${side_key[$s]:-}" "${commit_of[$t]:-}")"
          ! is_branch_term "$term" || [[ -z "$named" ]] || in_monorepo "$named" ||
            branch_tips["$sp|${side_of[$s]:-}"]+=" $named"
        fi
        if [[ -z "$named" ]]; then
          errors+=("$shown points at ${value[$t]}, but there's no $shown")
        elif [[ "${commit_of[$t]:-}" != "$named" ]]; then
          label="${label_of[$named]:-}"
          [[ -n "$label" ]] || label="${named:0:7}, which isn't drawn"
          errors+=("$shown points at ${value[$t]}, the code says $label")
        fi
      done <<<"${value[$s]// = /$'\n'}"
      continue
    fi
    if [[ "${kind[$t]:-}" == box ]]; then
      errors+=("an arrow from ${value[$s]} points at the box ${value[$t]}: draw it from the box to its commit")
      continue
    fi
    [[ "${kind[$s]:-}" == commit && "${kind[$t]:-}" == commit ]] || continue
    if [[ "${lane_of[$s]}" != "${lane_of[$t]}" ]]; then
      errors+=("${value[$s]} -> ${value[$t]} crosses lanes: draw a parent and its child in one lane")
      continue
    fi
    if [[ "${side_of[$s]:-}" != "${side_of[$t]:-}" ]]; then
      errors+=("${value[$s]} -> ${value[$t]} crosses the separator: draw the parent on ${value[$t]}'s side too")
      continue
    fi
    [[ -n "${commit_of[$s]:-}" && -n "${commit_of[$t]:-}" ]] || continue
    drawn_edges+="$s>$t "
    if ! git rev-parse "${commit_of[$t]}^@" | grep -qx "${commit_of[$s]}"; then
      errors+=("${value[$s]} -> ${value[$t]}: ${value[$s]} isn't a parent of ${value[$t]}")
    elif not_upstream "${commit_of[$t]}" "${splice_of[$t]}" "${side_key[$t]:-}"; then
      dashed "$id" || errors+=("${value[$s]} -> ${value[$t]} is solid, but no upstream branch has ${value[$t]}: dash it")
    else
      dashed "$id" && errors+=("${value[$s]} -> ${value[$t]} is dashed, but an upstream branch has ${value[$t]}: draw it solid")
    fi
  done
  # A solid commit T lacks is on another upstream branch: its box shows
  # which.
  local b found
  for id in "${commits[@]}"; do
    sp="${splice_of[$id]}"
    [[ -n "${commit_of[$id]:-}" && -n "$sp" ]] || continue
    ! in_monorepo "${commit_of[$id]}" || continue
    not_upstream "${commit_of[$id]}" "$sp" "${side_key[$id]:-}" && continue
    [[ -n "${truth["$sp|T"]}" ]] && git merge-base --is-ancestor "${commit_of[$id]}" "${truth["$sp|T"]}" && continue
    found=""
    for b in ${branch_tips["$sp|${side_of[$id]:-}"]:-}; do
      git merge-base --is-ancestor "${commit_of[$id]}" "$b" && found=1
    done
    [[ -n "$found" ]] || errors+=("${value[$id]} is on an upstream branch, but not T's: draw a box for the branch, e.g. $(
      git for-each-ref --count=1 --format='%(refname:lstrip=4)' --contains "${commit_of[$id]}" "refs/splices/${side_key[$id]:-${truth["$sp|key"]}}/heads/"
    )")
  done
  # Every box points at one commit.
  for id in "${boxes[@]}"; do
    [[ "${box_arrows[$id]:-0}" -eq 1 ]] ||
      errors+=("${value[$id]} has ${box_arrows[$id]:-0} arrows, not one: draw one from the box to its commit")
  done
  # Every parent link between two drawn commits of one lane is drawn.
  for t in "${commits[@]}"; do
    [[ -n "${commit_of[$t]:-}" ]] || continue
    for p in $(git rev-parse "${commit_of[$t]}^@"); do
      for s in "${commits[@]}"; do
        [[ "${commit_of[$s]:-}" == "$p" && "${lane_of[$s]}" == "${lane_of[$t]}" && "${side_of[$s]:-}" == "${side_of[$t]:-}" && "$drawn_edges" != *" $s>$t "* ]] &&
          errors+=("no arrow ${value[$s]} -> ${value[$t]}, though ${value[$s]} is a parent of ${value[$t]}")
      done
    done
  done

  if [[ ${#errors[@]} -gt 0 ]]; then
    printf '!!   %s\n' "${errors[@]}"
    return 1
  fi
  printf 'ok   %s: %d commits, %d arrows, %d boxes%s%s\n' \
    "${drawing##*/}" "${#commits[@]}" "${#edges[@]}" "${#boxes[@]}" \
    "$([[ ${#lanes[@]} -eq 0 ]] || printf ', %d lanes' "${#lanes[@]}")" \
    "$([[ ${#region_name[@]} -eq 0 ]] || printf ', %d upstreams' "${#region_name[@]}")"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  check_drawing "$@"
fi
